{
  "name": "@hummbl/mcp-server",
  "version": "1.3.0",
  "mcpName": "io.github.hummbl-io/mcp-server",
  "description": "Model Context Protocol server for the HUMMBL Base120 mental models framework",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "hummbl-mcp": "./dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "!dist/**/*.test.*",
    "!dist/__tests__/**",
    "README.md",
    "LICENSE",
    "product.json",
    "server.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "check:generated": "npm run build",
    "check:boundary": "node scripts/check-package-boundary.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jspdf": "^4.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "base120",
    "hummbl",
    "mcp",
    "model-context-protocol",
    "reasoning"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hummbl-io/oss.git",
    "directory": "packages/node/mcp-server"
  },
  "homepage": "https://hummbl.io/",
  "bugs": "https://github.com/hummbl-io/oss/issues"
}
