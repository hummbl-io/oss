{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.hummbl-io/mcp-server",
  "title": "HUMMBL Base120 MCP Server",
  "description": "MCP server for the HUMMBL Base120 mental models framework",
  "version": "1.3.0",
  "repository": {
    "url": "https://github.com/hummbl-io/oss",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@hummbl/mcp-server",
      "version": "1.3.0",
      "transport": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@hummbl/mcp-server"]
      }
    }
  ]
}
