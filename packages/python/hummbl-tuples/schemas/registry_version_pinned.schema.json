{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/tuples/registry_version_pinned.schema.json",
  "title": "Nodezero REGISTRY_VERSION_PINNED Tuple",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tuple_type",
    "time",
    "id",
    "run_id",
    "tuple_data"
  ],
  "properties": {
    "tuple_type": {
      "const": "REGISTRY_VERSION_PINNED"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "tuple_data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "issued_by",
        "transformation_registry_version",
        "mental_model_registry_version"
      ],
      "properties": {
        "issued_by": {
          "type": "string",
          "const": "nodezero"
        },
        "transformation_registry_version": {
          "type": "string",
          "minLength": 1
        },
        "mental_model_registry_version": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_rubric_version": {
          "type": "string"
        }
      }
    }
  }
}
