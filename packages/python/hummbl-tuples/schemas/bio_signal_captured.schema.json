{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/tuples/bio_signal_captured.schema.json",
  "title": "BIO_SIGNAL_CAPTURED Tuple",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tuple_type",
    "subject_id",
    "run_id",
    "control_mode",
    "tuple_data"
  ],
  "properties": {
    "tuple_type": { "const": "BIO_SIGNAL_CAPTURED" },
    "subject_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "control_mode": {
      "type": "string",
      "enum": [
        "AI_AUTONOMOUS",
        "AI_PROPOSE_HUMAN_CONFIRM",
        "HITL",
        "HOTL",
        "HUMAN_CONTROLLED"
      ]
    },
    "tuple_data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "signal_type",
        "value",
        "unit",
        "source",
        "timestamp"
      ],
      "properties": {
        "signal_type": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "minLength": 1 },
        "quality_score": { "type": "number", "minimum": 0 }
      }
    }
  }
}
