{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/tuples/hitl_override.schema.json",
  "title": "BaseN HITL_OVERRIDE Tuple",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tuple_type",
    "time",
    "id",
    "problem_id",
    "run_id",
    "control_mode",
    "tuple_data"
  ],
  "properties": {
    "tuple_type": {
      "const": "HITL_OVERRIDE"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "minLength": 1
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "control_mode": {
      "type": "string",
      "enum": [
        "AI_PROPOSE_HUMAN_CONFIRM",
        "HITL_INFLUENCED",
        "HITL_CONTROLLED",
        "HOTL_SUPERVISED"
      ]
    },
    "tuple_data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "overridden_tuple_id",
        "override_type",
        "human_actor",
        "override_reason"
      ],
      "properties": {
        "overridden_tuple_id": {
          "type": "string",
          "minLength": 1
        },
        "override_type": {
          "type": "string",
          "enum": [
            "TRANSFORMATION_CHANGE",
            "MODEL_CHANGE",
            "PATH_PRUNE",
            "PATH_FREEZE",
            "FORCED_SELECTION"
          ]
        },
        "human_actor": {
          "type": "string",
          "minLength": 1
        },
        "override_reason": {
          "type": "string",
          "minLength": 1
        },
        "replacement_transformation_id": {
          "type": "string"
        },
        "replacement_mental_model_id": {
          "type": "string"
        }
      }
    }
  }
}
