{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/tuples/reasoning_path.schema.json",
  "title": "BaseN REASONING_PATH Tuple",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tuple_type",
    "time",
    "id",
    "problem_id",
    "run_id",
    "control_mode",
    "tuple_data"
  ],
  "properties": {
    "tuple_type": {
      "const": "REASONING_PATH"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "minLength": 1
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "control_mode": {
      "type": "string",
      "enum": [
        "AI_AUTONOMOUS",
        "AI_PROPOSE_HUMAN_CONFIRM",
        "HITL_INFLUENCED",
        "HITL_CONTROLLED",
        "HOTL_SUPERVISED"
      ]
    },
    "tuple_data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "path_id",
        "constructed_by",
        "path_steps"
      ],
      "properties": {
        "path_id": {
          "type": "string",
          "minLength": 1
        },
        "constructed_by": {
          "type": "string",
          "minLength": 1
        },
        "path_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_index",
              "transformation_id",
              "mental_model_id"
            ],
            "properties": {
              "step_index": {
                "type": "integer",
                "minimum": 1
              },
              "transformation_id": {
                "type": "string",
                "minLength": 1
              },
              "mental_model_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "path_depth": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
