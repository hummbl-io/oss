{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/tuples/readiness_inferred.schema.json",
  "title": "READINESS_INFERRED Tuple",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tuple_type",
    "subject_id",
    "run_id",
    "control_mode",
    "tuple_data"
  ],
  "properties": {
    "tuple_type": { "const": "READINESS_INFERRED" },
    "subject_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "control_mode": {
      "type": "string",
      "enum": [
        "AI_AUTONOMOUS",
        "AI_PROPOSE_HUMAN_CONFIRM",
        "HITL",
        "HOTL",
        "HUMAN_CONTROLLED"
      ]
    },
    "tuple_data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "readiness_score",
        "inference_basis",
        "time_horizon",
        "confidence"
      ],
      "properties": {
        "readiness_score": { "type": "number" },
        "inference_basis": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "time_horizon": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0 },
        "review_required": { "type": "boolean" }
      }
    }
  }
}
