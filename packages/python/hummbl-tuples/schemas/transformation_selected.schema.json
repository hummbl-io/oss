{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/tuples/transformation_selected.schema.json",
  "title": "BaseN TRANSFORMATION_SELECTED Tuple",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tuple_type",
    "time",
    "id",
    "problem_id",
    "run_id",
    "control_mode",
    "tuple_data"
  ],
  "properties": {
    "tuple_type": {
      "const": "TRANSFORMATION_SELECTED"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "minLength": 1
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "control_mode": {
      "type": "string",
      "enum": [
        "AI_AUTONOMOUS",
        "AI_PROPOSE_HUMAN_CONFIRM",
        "HITL_INFLUENCED",
        "HITL_CONTROLLED",
        "HOTL_SUPERVISED"
      ]
    },
    "tuple_data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "transformation_id",
        "selected_by",
        "selection_rationale"
      ],
      "properties": {
        "transformation_id": {
          "type": "string",
          "minLength": 1
        },
        "selected_by": {
          "type": "string",
          "minLength": 1
        },
        "selection_rationale": {
          "type": "string",
          "minLength": 1
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 1
        },
        "confidence": {
          "type": "number"
        }
      }
    }
  }
}
