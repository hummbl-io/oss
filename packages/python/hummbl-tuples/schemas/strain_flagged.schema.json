{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/tuples/strain_flagged.schema.json",
  "title": "STRAIN_FLAGGED Tuple",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tuple_type",
    "subject_id",
    "run_id",
    "control_mode",
    "tuple_data"
  ],
  "properties": {
    "tuple_type": { "const": "STRAIN_FLAGGED" },
    "subject_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "control_mode": {
      "type": "string",
      "enum": [
        "AI_AUTONOMOUS",
        "AI_PROPOSE_HUMAN_CONFIRM",
        "HITL",
        "HOTL",
        "HUMAN_CONTROLLED"
      ]
    },
    "tuple_data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "flag_type",
        "severity",
        "threshold_basis",
        "recommended_response"
      ],
      "properties": {
        "flag_type": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "minLength": 1 },
        "threshold_basis": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "recommended_response": { "type": "string", "minLength": 1 }
      }
    }
  }
}
