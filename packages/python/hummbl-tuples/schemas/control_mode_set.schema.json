{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/tuples/control_mode_set.schema.json",
  "title": "Nodezero CONTROL_MODE_SET Tuple",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tuple_type",
    "time",
    "id",
    "run_id",
    "tuple_data"
  ],
  "properties": {
    "tuple_type": {
      "const": "CONTROL_MODE_SET"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "tuple_data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "issued_by",
        "control_mode"
      ],
      "properties": {
        "issued_by": {
          "type": "string",
          "const": "nodezero"
        },
        "control_mode": {
          "type": "string",
          "enum": [
            "AI_AUTONOMOUS",
            "AI_PROPOSE_HUMAN_CONFIRM",
            "HITL_INFLUENCED",
            "HITL_CONTROLLED",
            "HOTL_SUPERVISED"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    }
  }
}
