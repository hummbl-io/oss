{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/tuples/bio_action_blocked.schema.json",
  "title": "BIO_ACTION_BLOCKED Tuple",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tuple_type",
    "subject_id",
    "run_id",
    "control_mode",
    "tuple_data"
  ],
  "properties": {
    "tuple_type": { "const": "BIO_ACTION_BLOCKED" },
    "subject_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "control_mode": {
      "type": "string",
      "enum": [
        "AI_AUTONOMOUS",
        "AI_PROPOSE_HUMAN_CONFIRM",
        "HITL",
        "HOTL",
        "HUMAN_CONTROLLED"
      ]
    },
    "tuple_data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "action_id",
        "blocked_by",
        "block_reason",
        "policy_basis"
      ],
      "properties": {
        "action_id": { "type": "string", "minLength": 1 },
        "blocked_by": { "type": "string", "minLength": 1 },
        "block_reason": { "type": "string", "minLength": 1 },
        "policy_basis": { "type": "string", "minLength": 1 }
      }
    }
  }
}
