{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/tuples/bio_outcome_observed.schema.json",
  "title": "BIO_OUTCOME_OBSERVED Tuple",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tuple_type",
    "subject_id",
    "run_id",
    "control_mode",
    "tuple_data"
  ],
  "properties": {
    "tuple_type": { "const": "BIO_OUTCOME_OBSERVED" },
    "subject_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "control_mode": {
      "type": "string",
      "enum": [
        "AI_AUTONOMOUS",
        "AI_PROPOSE_HUMAN_CONFIRM",
        "HITL",
        "HOTL",
        "HUMAN_CONTROLLED"
      ]
    },
    "tuple_data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "action_id",
        "outcome_type",
        "observed_change",
        "measurement_basis",
        "confidence"
      ],
      "properties": {
        "action_id": { "type": "string", "minLength": 1 },
        "outcome_type": { "type": "string", "minLength": 1 },
        "observed_change": { "type": "string", "minLength": 1 },
        "measurement_basis": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "confidence": { "type": "number", "minimum": 0 }
      }
    }
  }
}
