{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/tuples/revocation.schema.json",
  "title": "HUMMBL REVOCATION Tuple",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tuple_type",
    "id",
    "time",
    "intent_id",
    "task_id",
    "tuple_data",
    "state",
    "drift",
    "tier",
    "agent",
    "tool"
  ],
  "properties": {
    "tuple_type": {
      "const": "REVOCATION"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "ok",
        "blocked",
        "error"
      ]
    },
    "drift": {
      "type": "number",
      "minimum": 0
    },
    "tier": {
      "type": "integer",
      "minimum": 0
    },
    "agent": {
      "type": "string"
    },
    "tool": {
      "type": "string"
    },
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string"
    },
    "tuple_data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "token_id",
        "subject",
        "revoked_by",
        "reason"
      ],
      "properties": {
        "token_id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "revoked_by": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "cascade": {
          "type": "boolean"
        },
        "terminal_state": {
          "type": "string"
        },
        "replacement_token_hash": {
          "type": "string"
        }
      }
    },
    "previous_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash of the previous tuple in the chain. null if genesis."
    }
  }
}
