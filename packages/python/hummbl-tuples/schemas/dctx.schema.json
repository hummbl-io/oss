{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/tuples/dctx.schema.json",
  "title": "HUMMBL DCTX Tuple",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tuple_type",
    "id",
    "time",
    "intent_id",
    "task_id",
    "tuple_data",
    "state",
    "drift",
    "tier",
    "agent",
    "tool"
  ],
  "properties": {
    "tuple_type": {
      "const": "DCTX"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "ok",
        "blocked",
        "error"
      ]
    },
    "drift": {
      "type": "number",
      "minimum": 0
    },
    "tier": {
      "type": "integer",
      "minimum": 0
    },
    "agent": {
      "type": "string"
    },
    "tool": {
      "type": "string"
    },
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string"
    },
    "tuple_data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "event"
      ],
      "properties": {
        "event": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "parent_task_id": {
          "type": "string"
        },
        "chain_depth": {
          "type": "integer",
          "minimum": 0
        },
        "adapter": {
          "type": "string"
        }
      }
    },
    "previous_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash of the previous tuple in the chain. null if genesis."
    }
  }
}
