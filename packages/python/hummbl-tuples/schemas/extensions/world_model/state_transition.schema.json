{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/tuples/extensions/world_model/state_transition.schema.json",
  "title": "World-Model STATE_TRANSITION Tuple",
  "description": "Records a state change from one state to another.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tuple_type", "id", "time", "actor", "principal",
    "control_mode", "tuple_data"
  ],
  "properties": {
    "tuple_type": {"const": "STATE_TRANSITION"},
    "id": {"type": "string", "minLength": 1},
    "time": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "principal": {"type": "string", "minLength": 1},
    "control_mode": {
      "type": "string",
      "enum": ["USER_DIRECT", "AI_PROPOSE_USER_CONFIRM", "AI_AUTONOMOUS"]
    },
    "tuple_data": {
      "type": "object",
      "required": [
        "target_model", "from_state", "to_state", "trigger",
        "evidence_links", "receipt_link", "visibility_class"
      ],
      "properties": {
        "target_model": {"type": "string"},
        "from_state": {"type": "string"},
        "to_state": {"type": "string"},
        "trigger": {"type": "string"},
        "evidence_links": {"type": "array", "items": {"type": "string"}},
        "receipt_link": {"type": "string"},
        "visibility_class": {
          "type": "string",
          "enum": ["private", "shared", "public"]
        }
      }
    }
  }
}
