{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/tuples/extensions/world_model/visibility_change.schema.json",
  "title": "World-Model VISIBILITY_CHANGE Tuple",
  "description": "Records a visibility state change as a first-class event.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tuple_type", "id", "time", "actor", "principal",
    "control_mode", "tuple_data"
  ],
  "properties": {
    "tuple_type": {"const": "VISIBILITY_CHANGE"},
    "id": {"type": "string", "minLength": 1},
    "time": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "principal": {"type": "string", "minLength": 1},
    "control_mode": {
      "type": "string",
      "enum": ["USER_DIRECT", "AI_PROPOSE_USER_CONFIRM", "AI_AUTONOMOUS"]
    },
    "tuple_data": {
      "type": "object",
      "required": [
        "target_model", "previous_visibility", "new_visibility",
        "change_reason", "receipt_link"
      ],
      "properties": {
        "target_model": {"type": "string"},
        "previous_visibility": {
          "type": "string",
          "enum": ["private", "shared", "public"]
        },
        "new_visibility": {
          "type": "string",
          "enum": ["private", "shared", "public"]
        },
        "change_reason": {"type": "string"},
        "receipt_link": {"type": "string"},
        "visibility_class": {
          "type": "string",
          "enum": ["private", "shared", "public"]
        }
      }
    }
  }
}
