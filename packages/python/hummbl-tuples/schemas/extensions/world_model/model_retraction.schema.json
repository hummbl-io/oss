{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/tuples/extensions/world_model/model_retraction.schema.json",
  "title": "World-Model MODEL_RETRACTION Tuple",
  "description": "Records retraction of a model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tuple_type", "id", "time", "actor", "principal",
    "control_mode", "tuple_data"
  ],
  "properties": {
    "tuple_type": {"const": "MODEL_RETRACTION"},
    "id": {"type": "string", "minLength": 1},
    "time": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "principal": {"type": "string", "minLength": 1},
    "control_mode": {
      "type": "string",
      "enum": ["USER_DIRECT", "AI_PROPOSE_USER_CONFIRM", "AI_AUTONOMOUS"]
    },
    "tuple_data": {
      "type": "object",
      "required": [
        "target_model", "retraction_reason",
        "user_approval_posture", "receipt_link", "visibility_class"
      ],
      "properties": {
        "target_model": {"type": "string"},
        "retraction_reason": {"type": "string"},
        "user_approval_posture": {
          "type": "string",
          "enum": ["approved", "pending", "rejected", "not_required"]
        },
        "receipt_link": {"type": "string"},
        "visibility_class": {
          "type": "string",
          "enum": ["private", "shared", "public"]
        }
      }
    }
  }
}
