{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/tuples/extensions/world_model/observation_event.schema.json",
  "title": "World-Model OBSERVATION_EVENT Tuple",
  "description": "Records an observation with structurally separated original expression, normalized observation, system interpretation, and user-approved interpretation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tuple_type", "id", "time", "actor", "principal",
    "control_mode", "tuple_data"
  ],
  "properties": {
    "tuple_type": {"const": "OBSERVATION_EVENT"},
    "id": {"type": "string", "minLength": 1},
    "time": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "principal": {"type": "string", "minLength": 1},
    "control_mode": {
      "type": "string",
      "enum": ["USER_DIRECT", "AI_PROPOSE_USER_CONFIRM", "AI_AUTONOMOUS"]
    },
    "tuple_data": {
      "type": "object",
      "required": [
        "original_expression", "normalized_observation",
        "system_interpretation", "context", "evidence_links",
        "uncertainty_posture", "receipt_link", "visibility_class"
      ],
      "properties": {
        "original_expression": {"type": "string"},
        "normalized_observation": {"type": "string"},
        "system_interpretation": {"type": "string"},
        "user_approved_interpretation": {"type": "string"},
        "context": {"type": "string"},
        "evidence_links": {"type": "array", "items": {"type": "string"}},
        "uncertainty_posture": {
          "type": "string",
          "enum": ["low", "moderate", "high", "unknown"]
        },
        "receipt_link": {"type": "string"},
        "visibility_class": {
          "type": "string",
          "enum": ["private", "shared", "public"]
        }
      }
    }
  }
}
