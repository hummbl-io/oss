{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/tuples/extensions/world_model/state_assertion.schema.json",
  "title": "World-Model STATE_ASSERTION Tuple",
  "description": "Asserts a state at a point in time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tuple_type", "id", "time", "actor", "principal",
    "control_mode", "tuple_data"
  ],
  "properties": {
    "tuple_type": {"const": "STATE_ASSERTION"},
    "id": {"type": "string", "minLength": 1},
    "time": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "principal": {"type": "string", "minLength": 1},
    "control_mode": {
      "type": "string",
      "enum": ["USER_DIRECT", "AI_PROPOSE_USER_CONFIRM", "AI_AUTONOMOUS"]
    },
    "tuple_data": {
      "type": "object",
      "required": [
        "target_model", "state_description", "effective_time",
        "evidence_links", "uncertainty_posture", "receipt_link",
        "visibility_class"
      ],
      "properties": {
        "target_model": {"type": "string"},
        "state_description": {"type": "string"},
        "effective_time": {"type": "string"},
        "previous_version": {"type": "string"},
        "evidence_links": {"type": "array", "items": {"type": "string"}},
        "uncertainty_posture": {
          "type": "string",
          "enum": ["low", "moderate", "high", "unknown"]
        },
        "receipt_link": {"type": "string"},
        "visibility_class": {
          "type": "string",
          "enum": ["private", "shared", "public"]
        }
      }
    }
  }
}
