{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/tuples/extensions/world_model/consent_change.schema.json",
  "title": "World-Model CONSENT_CHANGE Tuple",
  "description": "Records a consent state change as a first-class event.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tuple_type", "id", "time", "actor", "principal",
    "control_mode", "tuple_data"
  ],
  "properties": {
    "tuple_type": {"const": "CONSENT_CHANGE"},
    "id": {"type": "string", "minLength": 1},
    "time": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "principal": {"type": "string", "minLength": 1},
    "control_mode": {
      "type": "string",
      "enum": ["USER_DIRECT", "AI_PROPOSE_USER_CONFIRM", "AI_AUTONOMOUS"]
    },
    "tuple_data": {
      "type": "object",
      "required": [
        "target_model", "consent_type", "previous_consent",
        "new_consent", "change_reason",
        "receipt_link", "visibility_class"
      ],
      "properties": {
        "target_model": {"type": "string"},
        "consent_type": {
          "type": "string",
          "enum": ["model_training", "data_use", "sharing", "publication"]
        },
        "previous_consent": {
          "type": "string",
          "enum": ["granted", "denied", "not_requested"]
        },
        "new_consent": {
          "type": "string",
          "enum": ["granted", "denied", "not_requested"]
        },
        "change_reason": {"type": "string"},
        "receipt_link": {"type": "string"},
        "visibility_class": {
          "type": "string",
          "enum": ["private", "shared", "public"]
        }
      }
    }
  }
}
