{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bus.hummbl-dev.com/schemas/project-topology-manifest.v1.json",
  "title": "HUMMBL project topology manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "status", "cell", "sidecars", "evidence"],
  "properties": {
    "schema": { "const": "hummbl.bus.project-topology-manifest.v1" },
    "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "status": { "enum": ["proposed", "validated", "deployed"] },
    "cell": {
      "type": "object", "additionalProperties": false,
      "required": ["boundary", "canonical_writer", "message_types", "retention"],
      "properties": {
        "boundary": { "enum": ["project", "domain", "fleet", "external"] },
        "canonical_writer": { "type": "string", "minLength": 1 },
        "message_types": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "retention": { "type": "string", "minLength": 1 },
        "replicated_state_machine": { "type": "boolean", "default": false }
      }
    },
    "sidecars": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "object", "additionalProperties": false, "required": ["name", "role"], "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "role": { "enum": ["admission", "projection", "read-model", "observability", "relay"] },
        "status": { "enum": ["planned", "validated", "deployed", "unverified"] }
      }}
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["source_refs", "deployment_verified"],
      "properties": {
        "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "deployment_verified": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
