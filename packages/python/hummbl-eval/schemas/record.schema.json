{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hummbl.io/eval/v0/record.schema.json",
  "title": "HUMMBL Evaluation Record v0",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_id",
    "schema_version",
    "payload",
    "payload_digest",
    "canonicalization_profile",
    "actor_id",
    "source_id",
    "source_sequence",
    "created_at",
    "maturity",
    "confidentiality"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^urn:uuid:[0-9a-f-]{36}$"},
    "record_type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z][A-Za-z0-9_.-]*$"},
    "schema_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "minLength": 1},
    "payload": {},
    "payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "canonicalization_profile": {"const": "hummbl-jcs-1"},
    "actor_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_sequence": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "maturity": {"enum": ["draft", "candidate", "canonical", "deprecated", "revoked"]},
    "confidentiality": {"enum": ["public", "internal", "confidential", "restricted", "participant-sensitive"]}
  },
  "additionalProperties": false
}
