{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hummbl.io/eval/v0/relation.schema.json",
  "title": "HUMMBL Evaluation Relation v0",
  "type": "object",
  "required": [
    "relation_id",
    "relation_type",
    "source_record_id",
    "target_record_id",
    "actor_id",
    "source_id",
    "source_sequence",
    "asserted_at"
  ],
  "properties": {
    "relation_id": {"type": "string", "pattern": "^urn:uuid:[0-9a-f-]{36}$"},
    "relation_type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*:[a-z][a-z0-9_.-]*$"},
    "source_record_id": {"type": "string", "pattern": "^urn:uuid:[0-9a-f-]{36}$"},
    "target_record_id": {"type": "string", "pattern": "^urn:uuid:[0-9a-f-]{36}$"},
    "actor_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_sequence": {"type": "integer", "minimum": 0},
    "asserted_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
