{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorio-agent.system/schemas/telemetry_event.json",
  "title": "Telemetry Event",
  "description": "Schema for observability events",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "event_type",
    "source"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "span_start",
        "span_end",
        "metric",
        "log",
        "decision"
      ]
    },
    "source": {
      "type": "string"
    },
    "trace_id": {
      "type": "string"
    },
    "span_id": {
      "type": "string"
    },
    "parent_span_id": {
      "type": "string"
    },
    "attributes": {
      "type": "object"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  }
}