{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/sandbox-checkpoint-v0.1.schema.json",
  "title": "Sandbox Checkpoint v0.1",
  "description": "A verified digest record for state persisted outside a replaceable worker.",
  "type": "object",
  "required": [
    "schema_version",
    "checkpoint_id",
    "sandbox_id",
    "lease_id",
    "worker_id",
    "profile_digest",
    "sequence",
    "created_at",
    "state_digest",
    "previous_checkpoint_digest",
    "artifact_digests",
    "verified",
    "retention_class",
    "receipt_ref"
  ],
  "properties": {
    "schema_version": {"const": "sandbox-checkpoint.v0.1"},
    "checkpoint_id": {"type": "string", "pattern": "^chk-[a-z0-9-]+$"},
    "sandbox_id": {"type": "string", "pattern": "^sbx-[a-z0-9-]+$"},
    "lease_id": {"type": "string", "pattern": "^lease-[a-z0-9-]+$"},
    "worker_id": {"type": "string", "pattern": "^worker-[a-z0-9-]+$"},
    "profile_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "state_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "previous_checkpoint_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "artifact_digests": {
      "type": "array",
      "maxItems": 256,
      "items": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
    },
    "verified": {"const": true},
    "retention_class": {"type": "string", "enum": ["ephemeral", "task", "audit"]},
    "receipt_ref": {"type": "string", "pattern": "^rcpt-[a-z0-9-]+$"}
  },
  "additionalProperties": false
}
