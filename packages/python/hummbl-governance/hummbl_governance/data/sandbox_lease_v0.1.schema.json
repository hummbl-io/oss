{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/sandbox-lease-v0.1.schema.json",
  "title": "Sandbox Lease v0.1",
  "description": "A bounded worker lease governed by a durable host supervisor.",
  "type": "object",
  "required": [
    "schema_version",
    "lease_id",
    "sandbox_id",
    "profile_id",
    "profile_digest",
    "supervisor_id",
    "worker_id",
    "issued_at",
    "expires_at",
    "ttl_seconds",
    "renewal_count",
    "max_renewals",
    "restart_count",
    "max_restarts",
    "cumulative_budget",
    "status",
    "kill_switch_ref"
  ],
  "properties": {
    "schema_version": {"const": "sandbox-lease.v0.1"},
    "lease_id": {"type": "string", "pattern": "^lease-[a-z0-9-]+$"},
    "sandbox_id": {"type": "string", "pattern": "^sbx-[a-z0-9-]+$"},
    "profile_id": {"type": "string", "pattern": "^sp-[a-z0-9-]+$"},
    "profile_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "supervisor_id": {"type": "string", "pattern": "^supervisor-[a-z0-9-]+$"},
    "worker_id": {"type": "string", "pattern": "^worker-[a-z0-9-]+$"},
    "issued_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
    "renewal_count": {"type": "integer", "minimum": 0, "maximum": 168},
    "max_renewals": {"type": "integer", "minimum": 0, "maximum": 168},
    "restart_count": {"type": "integer", "minimum": 0, "maximum": 10},
    "max_restarts": {"type": "integer", "minimum": 0, "maximum": 10},
    "cumulative_budget": {
      "type": "object",
      "required": ["wall_seconds", "cpu_seconds", "output_bytes", "cost_usd"],
      "properties": {
        "wall_seconds": {"type": "integer", "minimum": 60, "maximum": 604800},
        "cpu_seconds": {"type": "integer", "minimum": 0, "maximum": 38707200},
        "output_bytes": {"type": "integer", "minimum": 0, "maximum": 7516192768},
        "cost_usd": {"type": "number", "minimum": 0, "maximum": 10000}
      },
      "additionalProperties": false
    },
    "status": {"type": "string", "enum": ["requested", "active", "expired", "revoked", "released"]},
    "kill_switch_ref": {"type": "string", "pattern": "^ksw-[a-z0-9-]+$"}
  },
  "additionalProperties": false
}
