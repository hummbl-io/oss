{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/sandbox-lifecycle-receipt-v0.1.schema.json",
  "title": "Sandbox Lifecycle Receipt v0.1",
  "description": "Host-signed requested-versus-effective control evidence for a sandbox event.",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "event",
    "sandbox_id",
    "lease_id",
    "worker_id",
    "supervisor_id",
    "profile_id",
    "profile_digest",
    "sequence",
    "timestamp",
    "outcome",
    "requested_controls",
    "effective_controls",
    "inactive_controls",
    "checkpoint_ref",
    "violation_code",
    "previous_receipt_digest",
    "receipt_digest",
    "signer_bridge",
    "budget_consumed"
  ],
  "properties": {
    "schema_version": {"const": "sandbox-lifecycle-receipt.v0.1"},
    "receipt_id": {"type": "string", "pattern": "^rcpt-[a-z0-9-]+$"},
    "event": {"type": "string", "enum": ["create", "start", "checkpoint", "lease_renew", "violation", "kill_switch", "destroy", "recovery"]},
    "sandbox_id": {"type": "string", "pattern": "^sbx-[a-z0-9-]+$"},
    "lease_id": {"type": "string", "pattern": "^lease-[a-z0-9-]+$"},
    "worker_id": {"type": "string", "pattern": "^worker-[a-z0-9-]+$"},
    "supervisor_id": {"type": "string", "pattern": "^supervisor-[a-z0-9-]+$"},
    "profile_id": {"type": "string", "pattern": "^sp-[a-z0-9-]+$"},
    "profile_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "outcome": {"type": "string", "enum": ["succeeded", "denied", "failed"]},
    "requested_controls": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "effective_controls": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "inactive_controls": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "checkpoint_ref": {"type": ["string", "null"], "pattern": "^chk-[a-z0-9-]+$"},
    "violation_code": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "previous_receipt_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "receipt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "signer_bridge": {"const": "host-bridge:signing"},
    "budget_consumed": {
      "type": "object",
      "required": ["wall_seconds", "cpu_seconds", "output_bytes", "cost_usd"],
      "properties": {
        "wall_seconds": {"type": "integer", "minimum": 0},
        "cpu_seconds": {"type": "integer", "minimum": 0},
        "output_bytes": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
