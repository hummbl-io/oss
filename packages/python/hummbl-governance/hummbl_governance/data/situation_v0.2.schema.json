{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/situation.v0.2.json",
  "title": "HUMMBL Situation v0.2",
  "type": "object",
  "required": [
    "situation_id",
    "schema_version",
    "created_at",
    "as_of",
    "created_by",
    "lifecycle",
    "resolution_status",
    "title",
    "governance",
    "sources",
    "source_independence",
    "claims",
    "evidence",
    "events",
    "contradictions",
    "gaps",
    "confidence",
    "decision_layers"
  ],
  "properties": {
    "situation_id": {"type": "string", "pattern": "^situation-[a-f0-9]{24}$"},
    "schema_version": {"const": "situation.v0.2"},
    "created_at": {"type": "string", "minLength": 20},
    "as_of": {"type": "string", "minLength": 20},
    "created_by": {"type": "string", "minLength": 1},
    "lifecycle": {"const": "DRAFT"},
    "resolution_status": {"enum": ["UNRESOLVED", "RESOLVED"]},
    "title": {"type": "string", "minLength": 1},
    "governance": {"$ref": "#/$defs/governance"},
    "sources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/source_status"}
    },
    "source_independence": {"$ref": "#/$defs/source_independence"},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "contradictions": {
      "type": "array",
      "items": {"$ref": "#/$defs/contradiction"}
    },
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "confidence": {"$ref": "#/$defs/confidence"},
    "decision_layers": {"$ref": "#/$defs/decision_layers"}
  },
  "additionalProperties": false,
  "$defs": {
    "nullable_string": {
      "oneOf": [{"type": "string"}, {"type": "null"}]
    },
    "string_array": {
      "type": "array",
      "items": {"type": "string"}
    },
    "governance": {
      "type": "object",
      "required": [
        "mutation_authority",
        "publication_status",
        "requires_human_review",
        "reviewer",
        "privacy_class",
        "prohibited_actions"
      ],
      "properties": {
        "mutation_authority": {"const": "NONE"},
        "publication_status": {"const": "DRAFT"},
        "requires_human_review": {"const": true},
        "reviewer": {"const": "Reuben"},
        "privacy_class": {"const": "INTERNAL"},
        "prohibited_actions": {
          "type": "array",
          "minItems": 5,
          "items": {
            "enum": [
              "account_action",
              "deployment",
              "external_message",
              "issue_or_pull_request_mutation",
              "process_restart"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "source_status": {
      "type": "object",
      "required": [
        "source_id",
        "freshness",
        "observed_at",
        "retrieved_at",
        "upstream_group",
        "retrieval_receipt_id"
      ],
      "properties": {
        "source_id": {"enum": ["coordination-bus", "github", "fleet-health"]},
        "freshness": {"enum": ["FRESH", "STALE", "MISSING", "ERROR"]},
        "observed_at": {"$ref": "#/$defs/nullable_string"},
        "retrieved_at": {"$ref": "#/$defs/nullable_string"},
        "upstream_group": {"type": "string", "minLength": 1},
        "retrieval_receipt_id": {"$ref": "#/$defs/nullable_string"}
      },
      "additionalProperties": false
    },
    "source_independence": {
      "type": "object",
      "required": [
        "registered_sources",
        "available_sources",
        "independent_upstreams",
        "shared_upstream_groups"
      ],
      "properties": {
        "registered_sources": {"const": 3},
        "available_sources": {"type": "integer", "minimum": 0, "maximum": 3},
        "independent_upstreams": {"type": "integer", "minimum": 0, "maximum": 3},
        "shared_upstream_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["upstream_group", "source_ids"],
            "properties": {
              "upstream_group": {"type": "string", "minLength": 1},
              "source_ids": {"$ref": "#/$defs/string_array"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "subject",
        "predicate",
        "value",
        "confidence",
        "source_ids",
        "upstream_groups",
        "evidence_refs",
        "contradicted"
      ],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^claim-[a-f0-9]{24}$"},
        "subject": {"type": "string"},
        "predicate": {"type": "string"},
        "value": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 0.95},
        "source_ids": {"$ref": "#/$defs/string_array"},
        "upstream_groups": {"$ref": "#/$defs/string_array"},
        "evidence_refs": {"$ref": "#/$defs/string_array"},
        "contradicted": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "source_id",
        "record_id",
        "subject",
        "predicate",
        "value",
        "summary",
        "observed_at",
        "freshness",
        "upstream_group",
        "retrieval_receipt_id",
        "quarantined",
        "redactions"
      ],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^evidence-[a-f0-9]{24}$"},
        "source_id": {"enum": ["coordination-bus", "github", "fleet-health"]},
        "record_id": {"type": "string", "minLength": 1},
        "subject": {"type": "string"},
        "predicate": {"type": "string"},
        "value": {"type": "string"},
        "summary": {"type": "string"},
        "observed_at": {"type": "string", "minLength": 20},
        "freshness": {"enum": ["FRESH", "STALE"]},
        "upstream_group": {"type": "string", "minLength": 1},
        "retrieval_receipt_id": {"type": "string", "minLength": 1},
        "quarantined": {"type": "boolean"},
        "redactions": {"$ref": "#/$defs/string_array"}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "event_id",
        "event_type",
        "occurred_at",
        "source_id",
        "summary",
        "evidence_ref"
      ],
      "properties": {
        "event_id": {"type": "string", "pattern": "^event-[a-f0-9]{24}$"},
        "event_type": {"type": "string"},
        "occurred_at": {"type": "string", "minLength": 20},
        "source_id": {"type": "string"},
        "summary": {"type": "string"},
        "evidence_ref": {"type": "string"}
      },
      "additionalProperties": false
    },
    "contradiction": {
      "type": "object",
      "required": [
        "contradiction_id",
        "subject",
        "predicate",
        "values",
        "evidence_refs",
        "resolution_status"
      ],
      "properties": {
        "contradiction_id": {
          "type": "string",
          "pattern": "^contradiction-[a-f0-9]{24}$"
        },
        "subject": {"type": "string"},
        "predicate": {"type": "string"},
        "values": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "evidence_refs": {"$ref": "#/$defs/string_array"},
        "resolution_status": {"const": "UNRESOLVED"}
      },
      "additionalProperties": false
    },
    "gap": {
      "type": "object",
      "required": ["gap_id", "source_id", "kind", "detail"],
      "properties": {
        "gap_id": {"type": "string", "pattern": "^gap-[a-f0-9]{24}$"},
        "source_id": {"enum": ["coordination-bus", "github", "fleet-health"]},
        "kind": {"enum": ["MISSING", "STALE", "ERROR", "QUARANTINED"]},
        "detail": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "object",
      "required": ["overall", "coverage_ceiling", "independence_ceiling", "method"],
      "properties": {
        "overall": {"type": "number", "minimum": 0, "maximum": 0.95},
        "coverage_ceiling": {"type": "number", "minimum": 0, "maximum": 1},
        "independence_ceiling": {"type": "number", "minimum": 0, "maximum": 1},
        "method": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "decision_layers": {
      "type": "object",
      "required": ["recommendations", "authorizations", "actions", "verification"],
      "properties": {
        "recommendations": {"$ref": "#/$defs/string_array"},
        "authorizations": {"type": "array", "maxItems": 0},
        "actions": {"type": "array", "maxItems": 0},
        "verification": {
          "type": "object",
          "required": ["status", "receipt_refs"],
          "properties": {
            "status": {"const": "NOT_RUN"},
            "receipt_refs": {"type": "array", "maxItems": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
