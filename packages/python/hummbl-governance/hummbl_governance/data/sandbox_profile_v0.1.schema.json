{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/sandbox-profile-v0.1.schema.json",
  "title": "Sandbox Profile v0.1",
  "description": "Fail-closed requested controls for one replaceable sandbox worker.",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "sandbox_id",
    "backend",
    "image_ref",
    "workspace_roots",
    "filesystem",
    "network",
    "credentials",
    "process",
    "resources",
    "mandatory_controls",
    "receipt_sink"
  ],
  "properties": {
    "schema_version": {"const": "sandbox-profile.v0.1"},
    "profile_id": {"type": "string", "pattern": "^sp-[a-z0-9-]+$"},
    "sandbox_id": {"type": "string", "pattern": "^sbx-[a-z0-9-]+$"},
    "backend": {"type": "string", "enum": ["docker", "bwrap", "windows_sandbox", "gvisor", "kata", "microvm"]},
    "image_ref": {"type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$"},
    "workspace_roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "filesystem": {
      "type": "object",
      "required": ["root_read_only", "writable_paths", "blocked_paths"],
      "properties": {
        "root_read_only": {"const": true},
        "writable_paths": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "blocked_paths": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 512}}
      },
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "required": ["mode", "allowed_destinations"],
      "properties": {
        "mode": {"type": "string", "enum": ["none", "egress_proxy"]},
        "allowed_destinations": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 253}}
      },
      "additionalProperties": false
    },
    "credentials": {
      "type": "object",
      "required": ["mode", "audiences"],
      "properties": {
        "mode": {"type": "string", "enum": ["none", "broker"]},
        "audiences": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      },
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "required": ["run_as_uid", "run_as_gid", "no_new_privileges", "capabilities"],
      "properties": {
        "run_as_uid": {"type": "integer", "minimum": 1, "maximum": 65535},
        "run_as_gid": {"type": "integer", "minimum": 1, "maximum": 65535},
        "no_new_privileges": {"const": true},
        "capabilities": {"type": "array", "maxItems": 0, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": ["cpu_cores", "memory_mib", "pids", "wall_time_seconds", "output_bytes"],
      "properties": {
        "cpu_cores": {"type": "number", "minimum": 0.1, "maximum": 64},
        "memory_mib": {"type": "integer", "minimum": 64, "maximum": 262144},
        "pids": {"type": "integer", "minimum": 1, "maximum": 4096},
        "wall_time_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "output_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824}
      },
      "additionalProperties": false
    },
    "mandatory_controls": {
      "type": "array",
      "minItems": 6,
      "maxItems": 16,
      "items": {
        "type": "string",
        "enum": [
          "network:none",
          "network:egress-proxy",
          "credentials:none",
          "credentials:broker",
          "rootfs:read-only",
          "no-new-privileges",
          "capabilities:none",
          "resource-limits",
          "seccomp",
          "landlock",
          "userns",
          "gvisor",
          "kata",
          "microvm"
        ]
      }
    },
    "receipt_sink": {"const": "host-bridge:receipts"}
  },
  "additionalProperties": false
}
