{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hummbl.dev/schemas/parallel_gate_receipt.schema.json",
  "title": "Parallel Gate Receipt",
  "description": "Deterministic receipt for parallel CI gates. Ensures failure attribution, log determinism, and artifact isolation.",
  "type": "object",
  "required": [
    "gate_name",
    "run_id",
    "timestamp",
    "status",
    "duration_ms",
    "receipt_hash",
    "deterministic_seed"
  ],
  "properties": {
    "gate_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Name of the gate (e.g. security-bandit)"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Unique run identifier (CI run ID + job ID)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of gate completion"
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "skipped", "error"],
      "description": "Gate execution status"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Gate execution duration in milliseconds"
    },
    "receipt_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 of receipt content (excluding the hash field itself)"
    },
    "deterministic_seed": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Seed used for randomized operations, or 'none'"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "rule", "line", "severity", "message"],
        "properties": {
          "file": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)\\S.*$", "description": "Relative POSIX file path"},
          "rule": {"type": "string", "minLength": 1, "pattern": "\\S", "description": "Rule or check ID"},
          "line": {"type": "integer", "minimum": 1},
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "message": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "additionalProperties": false
      },
      "description": "Findings from the gate (empty if status is pass)"
    },
    "environment": {
      "type": "object",
      "properties": {
        "runner": {"type": "string"},
        "python_version": {"type": "string"},
        "dependencies_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$", "description": "SHA-256 of dependency lockfile"}
      },
      "additionalProperties": false,
      "description": "Execution environment metadata"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum gate execution time"
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of retries on transient failure"
    },
    "retry_backoff": {
      "type": "string",
      "enum": ["exponential", "linear", "fixed", "none"],
      "description": "Backoff strategy for retries"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "fail"}}},
      "then": {
        "required": ["findings"],
        "properties": {
          "findings": {"minItems": 1},
          "retry_count": {"maximum": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "pass"}}},
      "then": {"properties": {"findings": {"maxItems": 0}}}
    }
  ],
  "additionalProperties": false
}
