{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.io/schemas/cognition/clp.ledger_entry.schema.json",
  "title": "LedgerEntry",
  "description": "Schema for Cognitive Ledger Protocol append-only memory entries (CLP v1.1.1).",
  "type": "object",
  "required": [
    "id",
    "timestamp",
    "agent",
    "vendor",
    "model",
    "type",
    "scope",
    "content",
    "content_hash"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(clp-[a-f0-9]{12}|thoth-.*|[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "lesson",
        "decision",
        "discovery",
        "correction",
        "convention",
        "inference",
        "HULE",
        "synthesis",
        "MILESTONE",
        "attestation"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "project",
        "agent",
        "system",
        "global",
        "session"
      ]
    },
    "content": {
      "type": "string",
      "maxLength": 4096
    },
    "content_hash": {
      "type": "string"
    },
    "evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10
    },
    "assurance_level": {
      "type": [
        "string",
        "null"
      ]
    },
    "signature": {
      "type": [
        "string",
        "null"
      ]
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 20
    },
    "claim": {
      "type": [
        "object",
        "null"
      ]
    },
    "color_team": {
      "type": [
        "string",
        "null"
      ]
    },
    "intel_types_consumed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intel_types_produced": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exercise_role": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "valid_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "contests": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}