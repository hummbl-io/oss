{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hummbl://enclave/lease/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lease_id",
    "mission_id",
    "subject",
    "issuer",
    "plan_hash",
    "target_state_hash",
    "max_uses",
    "issued_at",
    "expires_at",
    "nonce",
    "revocable"
  ],
  "properties": {
    "schema_version": { "const": "lease.v1" },
    "lease_id": { "type": "string" },
    "mission_id": { "type": "string" },
    "subject": { "type": "string" },
    "issuer": { "type": "string" },
    "plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target_state_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "max_uses": { "type": "integer", "minimum": 1 },
    "issued_at": { "type": "string" },
    "expires_at": { "type": "string" },
    "nonce": { "type": "string" },
    "revocable": { "const": true }
  }
}
