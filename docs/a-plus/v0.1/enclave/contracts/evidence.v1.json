{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hummbl://enclave/evidence/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "sequence",
    "previous_hash",
    "contract_id",
    "effect_id",
    "observed_at",
    "witnesses",
    "event_hash"
  ],
  "properties": {
    "schema_version": { "const": "evidence.v1" },
    "event_id": { "type": "string" },
    "sequence": { "type": "integer", "minimum": 0 },
    "previous_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contract_id": { "type": "string" },
    "effect_id": { "type": "string" },
    "observed_at": { "type": "string" },
    "witnesses": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "event_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
