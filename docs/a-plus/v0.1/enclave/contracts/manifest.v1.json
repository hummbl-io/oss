{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hummbl://enclave/manifest/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm",
    "canonicalization",
    "files",
    "package_hash"
  ],
  "properties": {
    "schema_version": { "const": "manifest.v1" },
    "algorithm": { "const": "sha256" },
    "canonicalization": {
      "const": "UTF-8 LF bytes; POSIX paths sorted lexicographically"
    },
    "files": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "package_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
