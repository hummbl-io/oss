{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hummbl.dev/schemas/public/release_guardrail_receipt.schema.json",
  "title": "Release/Guardrail Receipt v0.1",
  "description": "Minimal receipt schema for release/guardrail decisions on agent-generated tool calls.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "reason_code", "timestamp", "agent_identity"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["PROCEED", "NEEDS_REVIEW", "SILENCE"]
    },
    "reason_code": {
      "type": "string",
      "description": "Machine-readable reason for the decision",
      "examples": ["scope_boundary", "rate_limit", "malformed", "in_scope", "confidence_below_threshold"]
    },
    "evidence": {
      "type": "object",
      "description": "Structured evidence supporting the decision. Framework-specific.",
      "additionalProperties": true
    },
    "candidate_hash": {
      "type": "string",
      "description": "SHA-256 hash of the candidate tool call, for replay verification.",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of the decision."
    },
    "agent_identity": {
      "type": "string",
      "description": "Identity of the agent that generated the candidate tool call."
    }
  }
}
