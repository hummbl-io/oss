{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hummbl-io/oss/main/schemas/public/external-import-record-v1.schema.json",
  "title": "HUMMBL External Import Record v1",
  "description": "Schema for machine-readable provenance records of externally imported materials (test fixtures, vendored code, tools, references).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "record_id",
    "identity_and_selection",
    "integrity",
    "rights",
    "reuse_mode",
    "dependency_treatment",
    "ownership_and_decision",
    "maintenance"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "hummbl.external-import.v1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "identity_and_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_repository",
        "immutable_source_revision",
        "selected_source_paths",
        "destination_package",
        "destination_paths"
      ],
      "properties": {
        "upstream_repository": {
          "type": "string",
          "minLength": 1
        },
        "immutable_source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "specification_dialect": {
          "type": "string"
        },
        "selected_source_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "destination_package": {
          "type": "string",
          "minLength": 1
        },
        "destination_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_count",
        "inventory",
        "transformations"
      ],
      "properties": {
        "file_count": {
          "type": "integer",
          "minimum": 1
        },
        "inventory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "filename",
              "source_path",
              "destination_path",
              "bytes",
              "sha256",
              "git_blob_sha"
            ],
            "properties": {
              "filename": { "type": "string", "minLength": 1 },
              "source_path": { "type": "string", "minLength": 1 },
              "destination_path": { "type": "string", "minLength": 1 },
              "bytes": { "type": "integer", "minimum": 0 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "git_blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            }
          }
        },
        "transformations": {
          "type": "string"
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_licenses",
        "license_files",
        "attributions",
        "review_status",
        "unresolved_questions"
      ],
      "properties": {
        "declared_licenses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "license_files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "attributions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "review_status": {
          "type": "string",
          "enum": ["approved", "conditional", "hold", "rejected"]
        },
        "unresolved_questions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "reuse_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "rationale"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "external_tool",
            "dependency",
            "selected_code",
            "test_fixtures",
            "reference_only",
            "reject"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependency_treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_dependency_category",
        "vendored_third_party_code",
        "isolation_notes"
      ],
      "properties": {
        "runtime_dependency_category": {
          "type": "string",
          "enum": [
            "zero_runtime",
            "optional_integration",
            "build_only",
            "test_only",
            "vendored"
          ]
        },
        "vendored_third_party_code": {
          "type": "boolean"
        },
        "isolation_notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ownership_and_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owners_ref",
        "decision_ref",
        "approved_scope",
        "review_state",
        "exceptions"
      ],
      "properties": {
        "owners_ref": {
          "type": "string",
          "minLength": 1
        },
        "decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "approved_scope": {
          "type": "string",
          "minLength": 1
        },
        "review_state": {
          "type": "string",
          "enum": ["approved", "review_pending", "hold"]
        },
        "exceptions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "update_triggers",
        "local_delta_policy",
        "removal_conditions"
      ],
      "properties": {
        "update_triggers": {
          "type": "string",
          "minLength": 1
        },
        "local_delta_policy": {
          "type": "string",
          "minLength": 1
        },
        "removal_conditions": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
